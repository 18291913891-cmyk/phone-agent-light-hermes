HOST=0.0.0.0
PORT=8790
DEFAULT_PAGE=display.html
AGENT_LIGHT_URL=http://127.0.0.1:8790

# Optional. Leave empty to use offline mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local-agent integrations. They read private files under your home
# directory, so keep them disabled unless you understand the privacy impact.
ENABLE_HERMES_BINDING=0
ENABLE_CODEX_BINDING=0

# Optional Hermes log bridge settings.
# HERMES_AGENT_LOG=/path/to/.hermes/logs/agent.log
# HERMES_GATEWAY_LOG=/path/to/.hermes/logs/gateway.log
# PHONE_AGENT_LIVE_STATE_PATH=/path/to/.hermes/agent_live_state.json
PHONE_AGENT_HOOK_PRIORITY_MS=15000
HERMES_STATE_BRIDGE_POLL_MS=200

# Android WebView shell build target. Replace with your computer's LAN IP.
SHELL_URL=http://YOUR_COMPUTER_LAN_IP:8790/display.html
